# ==============================================================================
# SmartMate AI - Environment Configuration Template
# Copy this file to .env and fill in your values. NEVER commit .env to Git.
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Path (SQLite)
DB_PATH=./data/smartmate.sqlite

# Rate Limiting (requests per 15 minutes per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
CHAT_RATE_LIMIT_MAX=40

# AI Provider Configuration (Optional)
# Supported providers: gemini | openai | auto | fallback
# If no API key is configured, SmartMate AI automatically uses its transparent
# rule-based fallback decision engine.
AI_PROVIDER=auto

# Google Gemini API (Recommended when AI_PROVIDER=gemini or auto)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI-Compatible API (Used when AI_PROVIDER=openai or as secondary in auto)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Frontend (Vite) - Optional override if backend runs on another URL
VITE_API_BASE_URL=http://localhost:4000/api
